<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- 1. USERS TABLE -->
    <changeSet id="001-create-table-users" author="novaerp">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="users"/>
            </not>
        </preConditions>
        <createTable tableName="users">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="users_pkey" nullable="false"/>
            </column>
            <column name="full_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_users_email"/>
            </column>
            <column name="password" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="role" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- 2. PASSWORD RESET TOKENS TABLE -->
    <changeSet id="001-create-table-password-reset-tokens" author="novaerp">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="password_reset_tokens"/>
            </not>
        </preConditions>
        <createTable tableName="password_reset_tokens">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="password_reset_tokens_pkey" nullable="false"/>
            </column>
            <column name="token_hash" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_password_reset_tokens_hash"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_password_reset_tokens_user" references="users(id)"/>
            </column>
            <column name="expires_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="used_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- 3. CLIENTS TABLE -->
    <changeSet id="001-create-table-clients" author="novaerp">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="clients"/>
            </not>
        </preConditions>
        <createTable tableName="clients">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="clients_pkey" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)"/>
            <column name="phone" type="VARCHAR(255)"/>
            <column name="address" type="VARCHAR(255)"/>
            <column name="city" type="VARCHAR(255)"/>
            <column name="tax_number" type="VARCHAR(255)"/>
            <column name="notes" type="VARCHAR(1000)"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- 4. CATEGORIES TABLE -->
    <changeSet id="001-create-table-categories" author="novaerp">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="categories"/>
            </not>
        </preConditions>
        <createTable tableName="categories">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="categories_pkey" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_categories_name"/>
            </column>
            <column name="description" type="VARCHAR(255)"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- 5. UNITS TABLE -->
    <changeSet id="001-create-table-units" author="novaerp">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="units"/>
            </not>
        </preConditions>
        <createTable tableName="units">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="units_pkey" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_units_name"/>
            </column>
            <column name="symbol" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_units_symbol"/>
            </column>
        </createTable>
    </changeSet>

    <!-- 6. SUPPLIERS TABLE -->
    <changeSet id="001-create-table-suppliers" author="novaerp">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="suppliers"/>
            </not>
        </preConditions>
        <createTable tableName="suppliers">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="suppliers_pkey" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)"/>
            <column name="phone" type="VARCHAR(255)"/>
            <column name="address" type="VARCHAR(255)"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- 7. ARTICLES TABLE -->
    <changeSet id="001-create-table-articles" author="novaerp">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="articles"/>
            </not>
        </preConditions>
        <createTable tableName="articles">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="articles_pkey" nullable="false"/>
            </column>
            <column name="reference" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_articles_reference"/>
            </column>
            <column name="designation" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="brand" type="VARCHAR(255)"/>
            <column name="barcode" type="VARCHAR(255)"/>
            <column name="category_id" type="BIGINT">
                <constraints foreignKeyName="fk_articles_category" references="categories(id)"/>
            </column>
            <column name="unit_id" type="BIGINT">
                <constraints foreignKeyName="fk_articles_unit" references="units(id)"/>
            </column>
            <column name="purchase_price_ht" type="NUMERIC(19,4)">
                <constraints nullable="false"/>
            </column>
            <column name="unit_cost_ttc" type="NUMERIC(19,4)">
                <constraints nullable="false"/>
            </column>
            <column name="sale_price_ht" type="NUMERIC(19,4)">
                <constraints nullable="false"/>
            </column>
            <column name="stock_quantity" type="NUMERIC(19,4)">
                <constraints nullable="false"/>
            </column>
            <column name="min_stock_quantity" type="NUMERIC(19,4)">
                <constraints nullable="false"/>
            </column>
            <column name="serial_tracked" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(255)"/>
            <column name="notes" type="VARCHAR(255)"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>
    </changeSet>

    <!-- 8. ARTICLE SUPPLIER PRICES TABLE -->
    <changeSet id="001-create-table-article-supplier-prices" author="novaerp">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="article_supplier_prices"/>
            </not>
        </preConditions>
        <createTable tableName="article_supplier_prices">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="article_supplier_prices_pkey" nullable="false"/>
            </column>
            <column name="article_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_asp_article" references="articles(id)"/>
            </column>
            <column name="supplier_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_asp_supplier" references="suppliers(id)"/>
            </column>
            <column name="price_ht" type="NUMERIC(19,4)">
                <constraints nullable="false"/>
            </column>
            <column name="price_ttc" type="NUMERIC(19,4)">
                <constraints nullable="false"/>
            </column>
            <column name="tax_rate" type="NUMERIC(5,2)">
                <constraints nullable="false"/>
            </column>
            <column name="currency" type="VARCHAR(3)">
                <constraints nullable="false"/>
            </column>
            <column name="lead_time_days" type="INTEGER"/>
            <column name="quote_date" type="DATE"/>
            <column name="is_primary" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- 9. STOCK MOVEMENTS TABLE -->
    <changeSet id="001-create-table-stock-movements" author="novaerp">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="stock_movements"/>
            </not>
        </preConditions>
        <createTable tableName="stock_movements">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="stock_movements_pkey" nullable="false"/>
            </column>
            <column name="article_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_stock_movements_article" references="articles(id)"/>
            </column>
            <column name="type" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="quantity" type="NUMERIC(19,4)">
                <constraints nullable="false"/>
            </column>
            <column name="reference" type="VARCHAR(255)"/>
            <column name="note" type="VARCHAR(255)"/>
            <column name="created_by" type="BIGINT">
                <constraints foreignKeyName="fk_stock_movements_user" references="users(id)"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
