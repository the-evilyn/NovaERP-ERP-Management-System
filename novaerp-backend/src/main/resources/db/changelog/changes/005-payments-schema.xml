<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- 1. PAYMENTS TABLE -->
    <changeSet id="005-create-table-payments" author="novaerp">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="payments"/>
            </not>
        </preConditions>
        <createTable tableName="payments">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="payments_pkey" nullable="false"/>
            </column>
            <column name="payment_number" type="VARCHAR(50)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_payments_payment_number"/>
            </column>
            <column name="payment_type" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="customer_invoice_id" type="BIGINT">
                <constraints foreignKeyName="fk_payments_customer_invoice" references="customer_invoices(id)"/>
            </column>
            <column name="supplier_invoice_id" type="BIGINT">
                <constraints foreignKeyName="fk_payments_supplier_invoice" references="supplier_invoices(id)"/>
            </column>
            <column name="payment_method" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="NUMERIC(19,4)">
                <constraints nullable="false"/>
            </column>
            <column name="payment_date" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="reference_number" type="VARCHAR(100)"/>
            <column name="notes" type="VARCHAR(1000)"/>
            <column name="created_by" type="BIGINT">
                <constraints foreignKeyName="fk_payments_user" references="users(id)"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- 2. PAYMENTS INDEXES -->
    <changeSet id="005-create-indexes-payments" author="novaerp">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="payments"/>
        </preConditions>
        <createIndex indexName="idx_payments_customer_invoice_id" tableName="payments">
            <column name="customer_invoice_id"/>
        </createIndex>
        <createIndex indexName="idx_payments_supplier_invoice_id" tableName="payments">
            <column name="supplier_invoice_id"/>
        </createIndex>
        <createIndex indexName="idx_payments_payment_date" tableName="payments">
            <column name="payment_date"/>
        </createIndex>
        <createIndex indexName="idx_payments_type" tableName="payments">
            <column name="payment_type"/>
        </createIndex>
    </changeSet>

    <!-- 3. PAYMENTS CONSTRAINTS -->
    <changeSet id="005-create-constraints-payments" author="novaerp">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="payments"/>
        </preConditions>
        <sql>
            ALTER TABLE payments ADD CONSTRAINT chk_payments_amount CHECK (amount > 0);
            ALTER TABLE payments ADD CONSTRAINT chk_payments_invoice_exclusivity CHECK (
                (payment_type = 'CUSTOMER_PAYMENT' AND customer_invoice_id IS NOT NULL AND supplier_invoice_id IS NULL)
                OR
                (payment_type = 'SUPPLIER_PAYMENT' AND supplier_invoice_id IS NOT NULL AND customer_invoice_id IS NULL)
            );
        </sql>
    </changeSet>

</databaseChangeLog>
